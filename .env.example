FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Optional Google Calendar integration
GOOGLE_CALENDAR_CLIENT_ID=

# Optional plugins, comma-separated: ramble,pause-recurring,task-api,google-login,google-calendar
SEVENFLOW_PLUGINS=

# Optional Netlify Functions API
SEVENFLOW_API_BASE_URL=
TASK_API_ENCRYPTION_SECRET=
FIREBASE_SERVICE_ACCOUNT_JSON=

# Optional self-hosted Node server
HOST=127.0.0.1
PORT=8000

# Optional local test mode without Firebase
SEVENFLOW_LOCAL_AUTH=false
SEVENFLOW_LOCAL_USER_EMAIL=
SEVENFLOW_LOCAL_USER_PASSWORD=
SEVENFLOW_LOCAL_USER_ID=local-user
SEVENFLOW_LOCAL_SESSION_SECRET=
